# AuraAssist Connection Configuration
# Copy this file to .env and fill in your server details

# AuraAssist server URL (MCP endpoint)
# For local development: http://localhost:8000
# For production: https://your-domain.com
VITE_AURA_SERVER=http://localhost:8000

# Optional: Device backend (simulated, fastapi, hass, mqtt)
# VITE_DEVICE_BACKEND=simulated

# Optional: Build configuration
# VITE_APP_NAME="AuraAssist Simulator"
